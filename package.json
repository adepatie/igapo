{
  "name": "amazon-trail-gpt",
  "version": "0.1.0",
  "description": "Amazon Trail-inspired text adventure powered by GPT and an MCP server.",
  "type": "module",
  "main": "src/cli.js",
  "scripts": {
    "start": "node src/cli.js",
    "server": "node src/server/amazonTrailServer.js",
    "backend": "node src/server.js",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:preview": "vite preview --config frontend/vite.config.ts",
    "dev": "concurrently \"npm run backend\" \"npm run frontend:dev\"",
    "build": "npm run frontend:build",
    "preview": "npm run frontend:preview",
    "check": "node --check src/cli.js && node --check src/server/amazonTrailServer.js && node --check src/game/stateManager.js && node --check src/gpt/narrator.js && node --check src/game/events.js",
    "test": "npm run check && vitest run -c frontend/vite.config.ts",
    "test:watch": "vitest watch -c frontend/vite.config.ts",
    "test:e2e": "playwright test -c frontend/playwright.config.ts"
  },
  "keywords": [
    "gpt",
    "mcp",
    "text-adventure"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.3.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
