{
  "name": "@igapo/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run -c vite.config.ts",
    "test:watch": "vitest watch -c vite.config.ts",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:debug": "playwright test -c playwright.config.ts --debug",
    "test:e2e:ui": "playwright test -c playwright.config.ts --ui",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^1.6.1",
    "rimraf": "^6.0.0"
  }
}
